{
  "schemaVersion": 1,
  "id": "rtwrapper",
  "version": "${version}",
  "name": "RTWrapper",
  "description": "Queued, permission-checked native command dispatch API for other mods/datapacks. Fabric reimplementation of the vortacraftmc RTWrapper datapack protocol.",
  "authors": [
    "vortacraftmc",
    "Runtoolkit (original source)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/datapack/rtwrapper",
    "issues": "https://github.com/vortacraftmc/core/issues",
    "sources": "https://github.com/vortacraftmc/core"
  },
  "license": "MIT",
  "icon": "icon.png",
  "provides": [
    "vortacraftmc"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vortacraftmc.rtwrapper.RTWrapper"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "minecraft": "~1.21.1"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false,
      "links": {
        "modmenu.modrinth": "https://modrinth.com/datapack/rtwrapper"
      }
    }
  }
}
