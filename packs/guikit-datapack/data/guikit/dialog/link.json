{
  "type": "minecraft:notice",
  "title": { "text": "Web link", "color": "aqua" },
  "body": {
    "type": "minecraft:plain_message",
    "width": 280,
    "contents": { "text": "https only. No quotes. The menu closes so the player can click the chat link.", "color": "gray" }
  },
  "pause": false,
  "can_close_with_escape": true,
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "url",
      "label": { "text": "URL" },
      "initial": "https://",
      "max_length": 120,
      "width": 280
    }
  ],
  "action": {
    "label": { "text": "Save", "color": "green" },
    "width": 260,
    "action": {
      "type": "dynamic/run_command",
      "template": "function guikit:editor/ui/link {url:\"$(url)\"}"
    }
  }
}
