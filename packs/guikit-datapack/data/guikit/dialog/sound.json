    { "label": "Experience", "width": 240, "action": { "type": "run_command", "command": "function guikit:editor/ui/sound_orb" } },
    { "label": "Pling", "width": 240, "action": { "type": "run_command", "command": "function guikit:editor/ui/sound_pling" } },
    { "label": "Yes", "width": 240, "action": { "type": "run_command", "command": "function guikit:editor/ui/sound_yes" } },
    { "label": "No", "width": 240, "action": { "type": "run_command", "command": "function guikit:editor/ui/sound_no" } },
    { "label": "Level up", "width": 240, "action": { "type": "run_command", "command": "function guikit:editor/ui/sound_level" } }
  ]
