{
  "type": "minecraft:multi_action",
  "title": { "text": "Tools", "color": "gold" },
  "body": {
    "type": "minecraft:plain_message",
    "width": 280,
    "contents": { "text": "Auto refresh redraws the menu while it is open. Slot 26, delete, and close are under More.", "color": "gray" }
  },
  "pause": false,
  "can_close_with_escape": true,
  "columns": 1,
  "exit_action": {
    "label": { "text": "Back", "color": "gray" },
    "width": 280,
    "action": { "type": "run_command", "command": "function guikit:editor/ui/back" }
  },
  "actions": [
    {
      "label": { "text": "Previous page", "color": "white" },
      "width": 280,
      "action": { "type": "run_command", "command": "function guikit:editor/ui/page_prev" }
    },
    {
      "label": { "text": "Next page", "color": "white" },
      "width": 280,
      "action": { "type": "run_command", "command": "function guikit:editor/ui/page_next" }
    },
    {
      "label": { "text": "Rename menu…", "color": "gold" },
      "width": 280,
      "action": { "type": "show_dialog", "dialog": "guikit:rename_menu" }
    },
    {
      "label": { "text": "Auto refresh…", "color": "aqua" },
      "width": 280,
      "action": { "type": "show_dialog", "dialog": "guikit:refresh" }
    },
    {
      "label": { "text": "Container…", "color": "white" },
      "width": 280,
      "action": { "type": "show_dialog", "dialog": "guikit:container" }
    },
    {
      "label": { "text": "Timeout…", "color": "white" },
      "width": 280,
      "action": { "type": "show_dialog", "dialog": "guikit:timer" }
    },
    {
      "label": { "text": "Publish to players", "color": "green" },
      "width": 280,
      "action": { "type": "run_command", "command": "function guikit:editor/ui/publish_on" }
    },
    {
      "label": { "text": "Hide from players", "color": "gray" },
      "width": 280,
      "action": { "type": "run_command", "command": "function guikit:editor/ui/publish_off" }
    },
    {
      "label": { "text": "Preview", "color": "aqua" },
      "width": 280,
      "action": { "type": "run_command", "command": "function guikit:editor/ui/preview" }
    },
    {
      "label": { "text": "More…", "color": "white" },
      "width": 280,
      "action": { "type": "show_dialog", "dialog": "guikit:tools_more" }
    }
  ]
}
