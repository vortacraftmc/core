{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vortacraftmc/core archive registry",
  "type": "object",
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "status", "archived_on", "reason", "last_version", "license", "deploy", "successor"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["datapack", "mod", "resourcepack", "script", "other"] },
          "status": { "enum": ["archived", "frozen", "superseded"] },
          "archived_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reason": { "type": "string", "minLength": 1 },
          "last_version": { "type": "string" },
          "minecraft": { "type": "string" },
          "license": { "type": "string" },
          "deploy": { "enum": ["not_recommended", "review_required", "ok"] },
          "path": { "type": ["string", "null"], "description": "Path inside this repo, null if code is not kept here" },
          "source_url": { "type": ["string", "null"] },
          "successor": { "type": ["string", "null"] },
          "known_issues": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
