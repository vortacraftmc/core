{
  "namespace": "myserver",
  "menu_id": "hub",
  "display_name": "Server Hub",
  "timer_ticks": 1200,
  "follow": true,
  "distance_close": 24,
  "pack_description": "MyServer hub menu — generated by guigenmc v1.2.0",
  "container": {
    "type": "chest_minecart",
    "y_offset": 0.6,
    "glowing": false
  },
  "default_filler": "minecraft:black_stained_glass_pane",
  "extra_scores": ["srv_season"],
  "message_prefix": { "text": "[Hub] ", "color": "gold" },
  "on_open": ["playsound minecraft:block.amethyst_block.chime master @s ~ ~ ~ 0.6 1.4"],
  "on_close": [],
  "pages": [
    {
      "index": 0,
      "name": "Main",
      "widgets": [
        {
          "kind": "label",
          "slot": 0,
          "item": "minecraft:book",
          "name": { "text": "Welcome!", "color": "aqua", "bold": true },
          "lore": [
            { "text": "Right-click the cart,", "color": "gray", "italic": false },
            { "text": "then SHIFT-click buttons.", "color": "gray", "italic": false }
          ]
        },
        {
          "kind": "button",
          "slot": 1,
          "action_id": "warp_spawn",
          "item": "minecraft:beacon",
          "name": { "text": "Warp: Spawn", "color": "green" },
          "commands": ["tp @s 0 -60 0"],
          "sound": "minecraft:entity.enderman.teleport",
          "success_message": { "text": "Warped to spawn.", "color": "green" }
        },
        {
          "kind": "button",
          "slot": 2,
          "action_id": "nether_gate",
          "item": "minecraft:obsidian",
          "name": { "text": "Nether Gate", "color": "light_purple" },
          "commands": ["tp @s 100 40 100"],
          "condition": {
            "type": "dimension",
            "dimension": "the_nether",
            "fail_message": { "text": "Only works while you are in the Nether.", "color": "red" }
          }
        },
        {
          "kind": "button",
          "slot": 3,
          "action_id": "storm_caller",
          "item": "minecraft:trident",
          "name": { "text": "Call the Storm", "color": "blue", "enchanted": true },
          "commands": ["weather thunder"],
          "cooldown_ticks": 200,
          "condition": {
            "type": "weather",
            "weather": "clear",
            "fail_message": { "text": "It is not clear skies right now.", "color": "red" }
          }
        },
        {
          "kind": "button",
          "slot": 4,
          "action_id": "vip_kit",
          "item": "minecraft:golden_chestplate",
          "name": { "text": "VIP Kit", "color": "gold" },
          "lore": [{ "text": "Costs 1 diamond + season pass", "color": "gray", "italic": false }],
          "commands": ["give @s diamond_sword 1"],
          "condition": {
            "type": "score",
            "score": "srv_season",
            "matches": "1..",
            "fail_message": { "text": "Season pass required.", "color": "red" }
          },
          "cost": {
            "item": "minecraft:diamond",
            "count": 1,
            "fail_message": { "text": "You need 1 diamond.", "color": "red" }
          }
        },
        {
          "kind": "toggle",
          "slot": 5,
          "toggle": {
            "score": "hub_fly",
            "off_item": "minecraft:feather",
            "on_item": "minecraft:elytra",
            "off_name": { "text": "Fly: OFF", "color": "red" },
            "on_name": { "text": "Fly: ON", "color": "green" },
            "on_commands": ["effect give @s slow_falling 1000000 0 true"],
            "off_commands": ["effect clear @s slow_falling"]
          }
        },
        {
          "kind": "cycle",
          "slot": 6,
          "cycle": {
            "score": "hub_difficulty",
            "wrap": true,
            "options": [
              {
                "item": "minecraft:dandelion",
                "name": { "text": "Difficulty: Peaceful", "color": "green" },
                "commands": ["difficulty peaceful"]
              },
              {
                "item": "minecraft:iron_sword",
                "name": { "text": "Difficulty: Normal", "color": "yellow" },
                "commands": ["difficulty normal"]
              },
              {
                "item": "minecraft:netherite_sword",
                "name": { "text": "Difficulty: Hard", "color": "red", "enchanted": true },
                "commands": ["difficulty hard"]
              }
            ]
          }
        },
        {
          "kind": "random",
          "slot": 7,
          "action_id": "daily_crate",
          "item": "minecraft:chest",
          "name": { "text": "Daily Crate", "color": "aqua" },
          "cooldown_ticks": 400,
          "random": {
            "rewards": [
              {
                "weight": 5,
                "commands": ["give @s bread 3"],
                "message": { "text": "You won 3 bread!", "color": "green" }
              },
              {
                "weight": 2,
                "commands": ["give @s golden_apple 1"],
                "message": { "text": "Nice — a golden apple!", "color": "gold" }
              },
              {
                "weight": 1,
                "commands": ["give @s nether_star 1"],
                "message": { "text": "JACKPOT: Nether Star!", "color": "light_purple", "bold": true }
              }
            ]
          }
        },
        {
          "kind": "counter",
          "slot": 8,
          "action_id": "warp_charges",
          "item": "minecraft:ender_pearl",
          "name": { "text": "Warp Charges", "color": "darker_aqua" },
          "counter_score": "hub_charges",
          "counter_delta": 1,
          "counter_min": 0,
          "counter_max": 10,
          "counter_wrap": true
        },
        {
          "kind": "progress",
          "slot": 10,
          "progress_score": "hub_quest",
          "progress_max": 20,
          "progress_width": 5,
          "progress_full_item": "minecraft:lime_stained_glass_pane",
          "progress_empty_item": "minecraft:gray_stained_glass_pane"
        },
        {
          "kind": "link",
          "slot": 16,
          "action_id": "website",
          "item": "minecraft:paper",
          "name": { "text": "Our Website", "color": "aqua" },
          "url": "https://example.com",
          "link_text": { "text": "Open example.com", "color": "aqua" }
        },
        {
          "kind": "confirm",
          "slot": 17,
          "action_id": "reset_stats",
          "item": "minecraft:tnt",
          "name": { "text": "Reset my stats", "color": "red", "bold": true },
          "confirm_page": 2
        },
        {
          "kind": "nav",
          "slot": 18,
          "action_id": "to_settings",
          "item": "minecraft:arrow",
          "name": { "text": "Settings →", "color": "white" },
          "target_page": 1,
          "sound": "minecraft:ui.button.click"
        },
        {
          "kind": "close",
          "slot": 26,
          "action_id": "close_main",
          "item": "minecraft:barrier",
          "name": { "text": "Close", "color": "dark_red" }
        }
      ]
    },
    {
      "index": 1,
      "name": "Settings",
      "widgets": [
        {
          "kind": "label",
          "slot": 0,
          "item": "minecraft:compass",
          "name": { "text": "Settings", "color": "gold", "bold": true }
        },
        {
          "kind": "toggle",
          "slot": 10,
          "toggle": {
            "score": "hub_pvp",
            "off_item": "minecraft:shield",
            "on_item": "minecraft:crossbow",
            "off_name": { "text": "PvP: Protected", "color": "green" },
            "on_name": { "text": "PvP: Enabled", "color": "red" },
            "off_lore": [{ "text": "You cannot be attacked.", "color": "gray", "italic": false }],
            "on_lore": [{ "text": "Careful out there!", "color": "gray", "italic": false }]
          }
        },
        {
          "kind": "toggle",
          "slot": 12,
          "toggle": {
            "score": "hub_particles",
            "off_item": "minecraft:gunpowder",
            "on_item": "minecraft:firework_rocket",
            "off_name": { "text": "Particles: OFF", "color": "red" },
            "on_name": { "text": "Particles: ON", "color": "green" },
            "tick_while_on": ["particle minecraft:end_rod ~ ~1 ~ 0.3 0.3 0.3 0.01 1"]
          }
        },
        {
          "kind": "nav",
          "slot": 18,
          "action_id": "to_main",
          "item": "minecraft:arrow",
          "name": { "text": "← Back", "color": "white" },
          "target_page": 0
        },
        {
          "kind": "close",
          "slot": 26,
          "action_id": "close_settings",
          "item": "minecraft:barrier",
          "name": { "text": "Close", "color": "dark_red" }
        }
      ]
    },
    {
      "index": 2,
      "name": "Confirm Reset",
      "widgets": [
        {
          "kind": "label",
          "slot": 2,
          "item": "minecraft:red_stained_glass_pane",
          "name": { "text": "This cannot be undone!", "color": "red", "bold": true }
        },
        {
          "kind": "button",
          "slot": 11,
          "action_id": "reset_yes",
          "item": "minecraft:lime_concrete",
          "name": { "text": "YES, reset everything", "color": "dark_green" },
          "commands": [
            "scoreboard players reset @s hub_quest",
            "scoreboard players reset @s hub_charges",
            "tellraw @s [{\"text\":\"Stats were reset.\",\"color\":\"red\"}]"
          ],
          "functions": ["myserver:custom/after_reset"],
          "sound": "minecraft:entity.wither.death"
        },
        {
          "kind": "nav",
          "slot": 15,
          "item": "minecraft:red_concrete",
          "name": { "text": "NO, take me back", "color": "dark_red" },
          "target_page": 0
        },
        {
          "kind": "close",
          "slot": 26,
          "action_id": "close_confirm",
          "item": "minecraft:barrier",
          "name": { "text": "Close", "color": "dark_red" }
        }
      ]
    }
  ]
}
